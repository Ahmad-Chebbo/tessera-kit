{
    "name": "tessera/tessera-discounts",
    "description": "The Discounts module of Tessera.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "tessera/tessera-engine": "^2.0",
        "tessera/tessera-saas": "^2.0",
        "tessera/tessera-catalog": "^2.0",
        "tessera/tessera-customers": "^2.0",
        "tessera/tessera-sales": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Discounts\\": ""
        }
    },
    "extra": {
        "tessera": {
            "modules": [
                "App\\Modules\\Discounts\\DiscountsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "replace": {
        "ahmad-chebbo/tessera-discounts": "self.version"
    }
}

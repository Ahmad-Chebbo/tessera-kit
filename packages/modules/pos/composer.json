{
    "name": "tessera/tessera-pos",
    "description": "The point of sale of Tessera: the till, held orders, offline sales and cash drawer shifts.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "tessera/tessera-engine": "^4.0",
        "tessera/tessera-orders": "^4.0",
        "tessera/tessera-tenant": "^4.0",
        "tessera/tessera-catalog": "^4.0",
        "tessera/tessera-customers": "^4.0",
        "tessera/tessera-inventory": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Pos\\": ""
        }
    },
    "extra": {
        "tessera": {
            "modules": [
                "App\\Modules\\Pos\\PosServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    }
}

{
    "name": "tessera/tessera-inventory",
    "description": "The Inventory module of Tessera.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "tessera/tessera-engine": "^4.0",
        "tessera/tessera-tenant": "^4.0",
        "tessera/tessera-catalog": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Inventory\\": ""
        }
    },
    "extra": {
        "tessera": {
            "modules": [
                "App\\Modules\\Inventory\\InventoryServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "replace": {
        "ahmad-chebbo/tessera-inventory": "self.version"
    }
}

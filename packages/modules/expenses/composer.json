{
    "name": "tessera/tessera-expenses",
    "description": "The Expenses module of Tessera.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "tessera/tessera-engine": "^4.0",
        "tessera/tessera-tenant": "^4.0",
        "spatie/laravel-medialibrary": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Expenses\\": ""
        }
    },
    "extra": {
        "tessera": {
            "modules": [
                "App\\Modules\\Expenses\\ExpensesServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "replace": {
        "ahmad-chebbo/tessera-expenses": "self.version"
    }
}

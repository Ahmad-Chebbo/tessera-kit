{
    "name": "tessera/tessera-sales",
    "description": "The Sales bundle of Tessera: the point of sale and the orders together.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "tessera/tessera-engine": "^4.0",
        "tessera/tessera-orders": "^4.0",
        "tessera/tessera-pos": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Sales\\": ""
        }
    },
    "extra": {
        "tessera": {
            "modules": [
                "App\\Modules\\Sales\\SalesServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "replace": {
        "ahmad-chebbo/tessera-sales": "self.version"
    }
}

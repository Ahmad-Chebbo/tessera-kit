{
    "name": "tessera/tessera-sales",
    "description": "The Sales module of Tessera.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "tessera/tessera-engine": "^3.0",
        "tessera/tessera-tenant": "^3.0",
        "tessera/tessera-catalog": "^3.0",
        "tessera/tessera-customers": "^3.0",
        "tessera/tessera-inventory": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Sales\\": ""
        }
    },
    "extra": {
        "tessera": {
            "modules": [
                "App\\Modules\\Sales\\SalesServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "3.x-dev"
        }
    },
    "replace": {
        "ahmad-chebbo/tessera-sales": "self.version"
    }
}

{
    "name": "tessera/tessera-base",
    "description": "The base of Tessera: sign-in, users, roles and permissions. Add tessera-saas on top for companies, branches and subscriptions.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "tessera/tessera-engine": "^2.0",
        "inertiajs/inertia-laravel": "*",
        "tightenco/ziggy": "*",
        "spatie/laravel-permission": "*",
        "spatie/laravel-medialibrary": "*",
        "laravel/sanctum": "*"
    },
    "autoload": {
        "psr-4": {
            "Tessera\\Core\\": "src/",
            "App\\Modules\\Auth\\": "modules/Auth/",
            "App\\Modules\\Team\\": "modules/Team/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tessera\\Core\\CoreServiceProvider"
            ]
        },
        "tessera": {
            "modules": [
                "App\\Modules\\Auth\\AuthServiceProvider",
                "App\\Modules\\Team\\TeamServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "replace": {
        "ahmad-chebbo/tessera-base": "self.version"
    }
}

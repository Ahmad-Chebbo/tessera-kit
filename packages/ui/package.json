        "./toasts": "./src/toasts.js",
        "./i18n": "./src/i18n.js",
        "./locales": "./src/locales/index.js",
        "./theme.css": "./src/theme.css"
    },
    "files": ["src"],
    "peerDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "chart.js": "^4.5.1",
        "lucide-vue-next": "^0.563.0",
        "tailwindcss": "^4.0.0",
        "vue": "^3.5.0",
        "vue-chartjs": "^5.3.4",
        "vue-i18n": "^9.14.5"
    }

{
    "name": "@ahmad-chebbo/tessera-ui",
    "version": "0.1.0",
    "description": "The Tessera interface kit: Vue 3 components, composables, charts and the theme, for Inertia and Vite projects.",
    "type": "module",
    "license": "UNLICENSED",
    "exports": {
        ".": "./src/index.js",
        "./Components/*": "./src/Components/*",
        "./Composables/*": "./src/Composables/*.js",

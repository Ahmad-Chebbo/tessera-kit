{
    "name": "ahmad-chebbo/tessera-saas",
    "description": "The SaaS layer of Tessera: companies with branches and locations, subscriptions with plans and limits. Builds on tessera-base.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ahmad-chebbo/tessera-engine": "^1.0",
        "inertiajs/inertia-laravel": "*",
        "tightenco/ziggy": "*",
        "spatie/laravel-permission": "*",
        "spatie/laravel-medialibrary": "*",
        "laravel/sanctum": "*",
        "ahmad-chebbo/tessera-base": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Company\\": "modules/Company/",
            "App\\Modules\\Subscription\\": "modules/Subscription/"
        }
    },
    "extra": {
        "tessera": {
            "modules": [
                "App\\Modules\\Company\\CompanyServiceProvider",
                "App\\Modules\\Subscription\\SubscriptionServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "replace": {
        "ahmad-chebbo/tessera-core": "self.version"
    }
}

{
    "name": "tessera/tessera-saas",
    "description": "The SaaS layer of Tessera: plans, subscriptions and limits, and the screens a platform admin uses to create and manage tenants. Builds on tessera-tenant.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "tessera/tessera-engine": "^3.0",
        "inertiajs/inertia-laravel": "*",
        "tightenco/ziggy": "*",
        "spatie/laravel-permission": "*",
        "spatie/laravel-medialibrary": "*",
        "laravel/sanctum": "*",
        "tessera/tessera-tenant": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Subscription\\": "modules/Subscription/"
        }
    },
    "extra": {
        "tessera": {
            "modules": [
                "App\\Modules\\Subscription\\SubscriptionServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "3.x-dev"
        }
    },
    "replace": {
        "ahmad-chebbo/tessera-saas": "self.version",
        "ahmad-chebbo/tessera-core": "self.version"
    }
}

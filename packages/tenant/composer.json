{
    "name": "tessera/tessera-tenant",
    "description": "Tenants for Tessera: the business, its branches, stock locations, currencies and settings. Works for a single business or many. Builds on tessera-base.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "tessera/tessera-engine": "^4.0",
        "inertiajs/inertia-laravel": "*",
        "tightenco/ziggy": "*",
        "spatie/laravel-permission": "*",
        "spatie/laravel-medialibrary": "*",
        "laravel/sanctum": "*",
        "tessera/tessera-base": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Tenant\\": "modules/Tenant/"
        }
    },
    "extra": {
        "tessera": {
            "modules": [
                "App\\Modules\\Tenant\\TenantServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    }
}
